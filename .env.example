# Neon PostgreSQL connection string (pooled recommended for serverless).
# Copy to .env.local and set the real value — never commit secrets.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Auth.js session encryption. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-random-secret

# Canonical site URL. Used by Auth.js and by metadataBase / sitemap origin.
# Local: http://localhost:3000
# Production: https://your-real-domain (do not leave a placeholder domain)
AUTH_URL=http://localhost:3000

# Optional. Set to "true" only on a single-node host with durable local disk if you
# intentionally enable public/uploads in NODE_ENV=production. Ignored (always off) on Vercel.
# LEMMA_ALLOW_LOCAL_UPLOADS=true

# Google OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Optional. Grants admin role on first verified sign-in with this exact email address.
LEMMA_BOOTSTRAP_ADMIN_EMAIL=you@example.com
